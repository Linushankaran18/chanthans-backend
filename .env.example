# development | production
ENVIRONMENT=development

# Supabase: plain postgresql:// is accepted and normalized to postgresql+asyncpg://
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# r2 (production) | local (development only: saves to ./media, served at /media)
STORAGE_BACKEND=r2
LOCAL_MEDIA_DIR=media
LOCAL_MEDIA_URL=http://localhost:8000/media

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=

MAX_UPLOAD_SIZE_MB=10
# Comma-separated list; no "*" in production
ALLOWED_ORIGINS=http://localhost:5173

# IANA timezone of the studio. Booking dates/times are studio-local; "today" and conflicts use it.
APP_TIMEZONE=America/Toronto
# Where the browser lands after Google sign-in (the admin dashboard origin; also list it in ALLOWED_ORIGINS)
FRONTEND_URL=http://localhost:5173

# Google Calendar integration (optional: leave blank and the app runs with the integration disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8000/api/v1/integrations/google-calendar/callback
# Production: https://api.chanthans.com/api/v1/integrations/google-calendar/callback
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_SCOPES=openid email https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_DEFAULT_ID=primary
# Encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
